{
  "id": "endurance",
  "name": "Endurance Blue",
  "clientName": "Example Endurance Client",
  "version": "1.0.0",
  "themeUrl": "/packages/endurance/theme.css",
  "slots": {
    "timing-tower": { "label": "Timing tower", "description": "Class-aware running order", "fields": [{ "key": "rows", "label": "Visible drivers", "type": "number", "default": 12, "min": 5, "max": 20 }, { "key": "metric", "label": "Mode", "type": "select", "default": "interval", "options": [{ "label": "Gap", "value": "gap" }, { "label": "Interval", "value": "interval" }, { "label": "Last lap", "value": "lastLap" }, { "label": "Best lap", "value": "bestLap" }] }] },
    "results": { "label": "Results page", "description": "Top-ten session results", "fields": [{ "key": "sessionType", "label": "Session results", "type": "select", "default": "practice", "options": [{ "label": "Practice", "value": "practice" }, { "label": "Qualifying", "value": "qualifying" }, { "label": "Race", "value": "race" }] }, { "key": "metric", "label": "Driver data", "type": "select", "default": "speed", "options": [{ "label": "Speed", "value": "speed" }, { "label": "Gap to leader", "value": "gap" }] }] },
    "race-status": { "label": "Race status", "description": "Session and stint status", "fields": [{ "key": "showTrack", "label": "Show track", "type": "boolean", "default": true }] },
    "driver-focus": { "label": "Driver info", "description": "Followed or manually selected driver and team", "fields": [{ "key": "subtitle", "label": "Subtitle", "type": "text", "default": "CURRENT STINT" }, { "key": "metric", "label": "Primary metric", "type": "select", "default": "interval", "options": [{ "label": "Best lap", "value": "bestLap" }, { "label": "Last lap", "value": "lastLap" }, { "label": "Interval", "value": "interval" }] }] },
    "battle": { "label": "Battle", "description": "Position-based group battle", "fields": [{ "key": "label", "label": "Headline", "type": "text", "default": "GAP ON TRACK" }] },
    "lower-third": { "label": "Announcement", "description": "Production announcement", "fields": [{ "key": "headline", "label": "Headline", "type": "text", "default": "ENDURANCE UPDATE" }, { "key": "detail", "label": "Detail", "type": "text", "default": "" }] }
  }
}
