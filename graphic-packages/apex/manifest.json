{
  "id": "apex",
  "name": "Apex Signal",
  "clientName": "Apex Racing",
  "version": "1.0.0",
  "themeUrl": "/packages/apex/theme.css",
  "slots": {
    "timing-tower": {
      "label": "Timing tower",
      "description": "Running order and live intervals",
      "fields": [
        { "key": "rows", "label": "Visible drivers", "type": "number", "default": 12, "min": 5, "max": 20 },
        { "key": "showLastLap", "label": "Show last lap", "type": "boolean", "default": false }
      ]
    },
    "race-status": {
      "label": "Race status",
      "description": "Session, lap, time, and flag",
      "fields": [{ "key": "showTrack", "label": "Show track", "type": "boolean", "default": true }]
    },
    "driver-focus": {
      "label": "Driver focus",
      "description": "Focused driver identity and performance",
      "fields": [
        { "key": "subtitle", "label": "Subtitle", "type": "text", "default": "", "source": "operator" },
        { "key": "metric", "label": "Primary metric", "type": "select", "default": "bestLap", "options": [{ "label": "Best lap", "value": "bestLap" }, { "label": "Last lap", "value": "lastLap" }, { "label": "Interval", "value": "interval" }] }
      ]
    },
    "battle": {
      "label": "Battle",
      "description": "Focused driver and nearest rival",
      "fields": [{ "key": "label", "label": "Headline", "type": "text", "default": "BATTLE FOR POSITION" }]
    },
    "flag": {
      "label": "Flag",
      "description": "Full-width race-control flag notice",
      "fields": [{ "key": "message", "label": "Override message", "type": "text", "default": "" }]
    },
    "lower-third": {
      "label": "Lower third",
      "description": "Operator-authored announcement",
      "fields": [
        { "key": "headline", "label": "Headline", "type": "text", "default": "RACE CONTROL" },
        { "key": "detail", "label": "Detail", "type": "text", "default": "" }
      ]
    }
  }
}
