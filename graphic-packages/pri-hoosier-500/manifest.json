{
  "id": "pri-hoosier-500",
  "name": "PRI Hoosier 500",
  "clientName": "PRI",
  "version": "1.0.0",
  "themeUrl": "/packages/pri-hoosier-500/theme.css",
  "slots": {
    "timing-tower": {
      "label": "Timing tower",
      "description": "Running order and live intervals",
      "fields": [
        { "key": "totalCars", "label": "Cars included", "type": "number", "default": 20, "min": 5, "max": 63 },
        { "key": "visibleRows", "label": "Visible slots", "type": "number", "default": 12, "min": 5, "max": 20 },
        { "key": "fixedPositions", "label": "Fixed positions", "type": "number", "default": 5, "min": 0, "max": 19 },
        { "key": "metric", "label": "Mode", "type": "select", "default": "interval", "options": [{ "label": "Gap", "value": "gap" }, { "label": "Interval", "value": "interval" }, { "label": "Last lap", "value": "lastLap" }, { "label": "Best lap", "value": "bestLap" }] }
      ]
    },
    "results": {
      "label": "Results page",
      "description": "Top-ten results from a retained session",
      "fields": [
        { "key": "sessionType", "label": "Session results", "type": "select", "default": "practice", "options": [{ "label": "Practice", "value": "practice" }, { "label": "Qualifying", "value": "qualifying" }, { "label": "Race", "value": "race" }] },
        { "key": "metric", "label": "Driver data", "type": "select", "default": "speed", "options": [{ "label": "Speed", "value": "speed" }, { "label": "Gap to leader", "value": "gap" }] }
      ]
    },
    "race-status": {
      "label": "Race status",
      "description": "Session, lap, time, and flag",
      "fields": [{ "key": "showTrack", "label": "Show track", "type": "boolean", "default": true }]
    },
    "driver-focus": {
      "label": "Driver info",
      "description": "Followed or manually selected driver identity and performance",
      "fields": [
        { "key": "subtitle", "label": "Subtitle", "type": "text", "default": "", "source": "operator" },
        { "key": "metric", "label": "Primary metric", "type": "select", "default": "bestLap", "options": [{ "label": "Best lap", "value": "bestLap" }, { "label": "Last lap", "value": "lastLap" }, { "label": "Interval", "value": "interval" }] }
      ]
    },
    "battle": {
      "label": "Battle",
      "description": "Position-based group battle",
      "fields": [{ "key": "label", "label": "Headline", "type": "text", "default": "BATTLE FOR POSITION" }]
    },
    "lower-third": {
      "label": "Announcement",
      "description": "Operator-authored announcement",
      "fields": [
        { "key": "headline", "label": "Headline", "type": "text", "default": "RACE CONTROL" },
        { "key": "detail", "label": "Detail", "type": "text", "default": "" }
      ]
    }
  }
}
