<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RaceControl.TelemetryClient</RootNamespace>
    <AssemblyName>BroadcastGraphicsClient</AssemblyName>
    <Product>Gantry Telemetry Client</Product>
    <ApplicationIcon>Resources\Brand\gantry.ico</ApplicationIcon>
    <Version>0.6.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\Fonts\*.ttf" />
    <Resource Include="Resources\Brand\*.png" />
    <Resource Include="Resources\Brand\*.ico" />
    <None Include="Resources\Fonts\OFL-*.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>
