<Window x:Class="RaceControl.TelemetryClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Broadcast Graphics Telemetry Client"
        Width="1080" Height="760" MinWidth="880" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Background="{StaticResource StockBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,0,0,3" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Text="BROADCAST GRAPHICS" />
                    <TextBlock Foreground="{StaticResource OrangeBrush}" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="12" Text="TELEMETRY BRIDGE" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" Text="WINDOWS CLIENT" />
                    <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0A15191C">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="ServerIndicator" Width="10" Height="42" Background="{StaticResource BadBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Text="SERVER" />
                        <TextBlock x:Name="ServerStatusText" Foreground="{StaticResource MutedBrush}" Text="Not connected" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,1,0" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="SourceIndicator" Width="10" Height="42" Background="{StaticResource BadBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Text="IRACING SOURCE" />
                        <TextBlock x:Name="SourceStatusText" Foreground="{StaticResource MutedBrush}" Text="Not connected" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="22,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="StreamIndicator" Width="10" Height="42" Background="{StaticResource BadBrush}" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Text="DATA STREAM" />
                        <TextBlock x:Name="StreamStatusText" Foreground="{StaticResource MutedBrush}" Text="Waiting for telemetry" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" MinWidth="390" />
                <ColumnDefinition Width="11*" MinWidth="430" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,22,24,24">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CONNECTION" />
                    <TextBlock Margin="0,4,0,20" Foreground="{StaticResource MutedBrush}" Text="Connect the local iRacing data source to the hosted graphics server." TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="SERVER URL" />
                    <TextBox x:Name="ServerUrlBox" Margin="0,0,0,14" AutomationProperties.Name="Server URL" />

                    <TextBlock Style="{StaticResource FieldLabel}" Text="INGESTION KEY" />
                    <PasswordBox x:Name="IngestionKeyBox" Margin="0,0,0,7" AutomationProperties.Name="Ingestion key" />
                    <Grid Margin="0,0,0,17">
                        <CheckBox x:Name="RememberKeyCheck" VerticalAlignment="Center" Content="Remember securely on this PC" />
                        <Button x:Name="ForgetKeyButton" HorizontalAlignment="Right" MinHeight="28" Padding="8,3" Click="ForgetKey_Click" Content="FORGET SAVED KEY" />
                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="TELEMETRY SOURCE" />
                    <ComboBox x:Name="SourceModeBox" Margin="0,0,0,12" SelectionChanged="SourceMode_SelectionChanged" AutomationProperties.Name="Telemetry source">
                        <ComboBoxItem Tag="Live" Content="Live iRacing SDK" />
                        <ComboBoxItem Tag="Simulation" Content="Simulated telemetry" />
                        <ComboBoxItem Tag="DiagnosticReplay" Content="Diagnostic replay" />
                    </ComboBox>

                    <StackPanel x:Name="ReplayFilePanel" Margin="0,0,0,16" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="DIAGNOSTIC CAPTURE" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReplayPathBox" IsReadOnly="True" AutomationProperties.Name="Diagnostic replay ZIP" />
                            <Button x:Name="BrowseReplayButton" Grid.Column="1" Margin="8,0,0,0" Click="BrowseReplay_Click" Content="BROWSE…" />
                        </Grid>
                        <TextBlock x:Name="ReplayValidationText" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" Text="Choose a diagnostic ZIP containing normalized telemetry." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />

                        <Border x:Name="ReplaySummaryPanel" Margin="0,10,0,0" Padding="10" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Background="#26B8C2BD" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Text="REPLAY VERIFIED" />
                                <TextBlock x:Name="ReplaySessionText" Margin="0,3,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReplayTrackText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ReplayDetailsText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,12,0,5" Style="{StaticResource FieldLabel}" Text="PLAYBACK SPEED" />
                        <ComboBox x:Name="ReplaySpeedBox" AutomationProperties.Name="Replay playback speed">
                            <ComboBoxItem Tag="0.5" Content="0.5×" />
                            <ComboBoxItem Tag="1" Content="1× — captured timing" />
                            <ComboBoxItem Tag="2" Content="2×" />
                            <ComboBoxItem Tag="-1" Content="Maximum — no timing delay" />
                        </ComboBox>

                        <Border x:Name="ReplayTransportPanel" Margin="0,12,0,0" Padding="10" BorderBrush="{StaticResource InkBrush}" BorderThickness="2" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,7">
                                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="16" Text="REPLAY CONTROL" />
                                    <TextBlock x:Name="ReplayProgressText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Text="00:00 / 00:00" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                                <ProgressBar x:Name="ReplayProgressBar" Minimum="0" Maximum="1" Value="0" AutomationProperties.Name="Replay progress" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="ReplayPauseButton" Margin="0,0,4,0" MinHeight="36" Click="ReplayPause_Click" Content="PAUSE" />
                                    <Button x:Name="ReplayRestartButton" Grid.Column="1" Margin="4,0,0,0" MinHeight="36" Click="ReplayRestart_Click" Content="RESTART" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border x:Name="ErrorPanel" Margin="0,0,0,14" Padding="10" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" Background="#0FC53127" Visibility="Collapsed" Focusable="True" AutomationProperties.LiveSetting="Assertive">
                        <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border x:Name="ReplayWarningPanel" Margin="0,0,0,14" Padding="12" BorderBrush="{StaticResource OrangeBrush}" BorderThickness="2" Background="#12FF4B21" Visibility="Collapsed" Focusable="True" AutomationProperties.LiveSetting="Assertive">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold" Text="CONFIRM REMOTE REPLAY" />
                            <TextBlock x:Name="ReplayWarningText" Margin="0,3,0,10" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Margin="0,0,4,0" Click="CancelReplayWarning_Click" Content="CANCEL" />
                                <Button Grid.Column="1" Margin="4,0,0,0" Style="{StaticResource PrimaryButton}" Click="ConfirmReplay_Click" Content="START REPLAY" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ConnectButton" Grid.Column="0" Margin="0,0,5,0" Style="{StaticResource PrimaryButton}" Click="Connect_Click" Content="CONNECT" IsDefault="True" />
                        <Button x:Name="DisconnectButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource DarkButton}" Click="Disconnect_Click" Content="DISCONNECT" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="2,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Margin="24,22,24,20">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="DIAGNOSTICS" />
                        <TextBlock Margin="0,4,0,18" Foreground="{StaticResource MutedBrush}" Text="Capture SDK metadata, session information, sampled telemetry, normalized output, and connection events into a local ZIP." TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SAMPLE RATE" />
                                <ComboBox x:Name="DiagnosticRateBox" AutomationProperties.Name="Diagnostic sample rate">
                                    <ComboBoxItem Tag="1" Content="1 sample / second" />
                                    <ComboBoxItem Tag="2" Content="2 samples / second" />
                                    <ComboBoxItem Tag="5" Content="5 samples / second" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MAXIMUM DURATION" />
                                <ComboBox x:Name="DiagnosticDurationBox" AutomationProperties.Name="Diagnostic maximum duration">
                                    <ComboBoxItem Tag="0" Content="Manual stop" />
                                    <ComboBoxItem Tag="1" Content="1 minute" />
                                    <ComboBoxItem Tag="5" Content="5 minutes" />
                                    <ComboBoxItem Tag="10" Content="10 minutes" />
                                    <ComboBoxItem Tag="30" Content="30 minutes" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="StartCaptureButton" Margin="0,0,5,0" Style="{StaticResource PrimaryButton}" Click="StartCapture_Click" Content="START CAPTURE" IsEnabled="False" />
                            <Button x:Name="StopCaptureButton" Grid.Column="1" Margin="5,0,0,0" Style="{StaticResource DarkButton}" Click="StopCapture_Click" Content="STOP &amp; SAVE" IsEnabled="False" />
                        </Grid>
                        <TextBlock x:Name="DiagnosticStatusText" Margin="0,12,0,0" FontWeight="SemiBold" Text="Connect the bridge to enable diagnostics." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="CapturePathText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,2,0,0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Margin="24,0">
                                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="20" Text="ACTIVITY LOG" />
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="28" Padding="8,3" Click="ClearLog_Click" Content="CLEAR LOG" />
                            </Grid>
                            <ListBox x:Name="ActivityLog" Grid.Row="1" Margin="24,0,24,20" Padding="8" BorderBrush="{StaticResource InkBrush}" BorderThickness="1" Background="#0A15191C" FontFamily="{StaticResource BodyFont}" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource InkBrush}" Padding="14,0">
            <Grid>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource StockBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="11" Text="KEYS REMAIN LOCAL · CAPTURES ARE NEVER UPLOADED AUTOMATICALLY" />
                <TextBlock x:Name="LastSentText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource InspectionBrush}" FontSize="11" Text="NO TELEMETRY SENT" />
            </Grid>
        </Border>
    </Grid>
</Window>
